# Caddy als Reverse Proxy vor dem Node-Server.
# Holt und erneuert das Let's-Encrypt-Zertifikat selbstständig.
#
#   sudo apt install caddy
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Voraussetzungen:
#   - Port 80 UND 443 im Router auf die Pi weiterleiten
#     (80 wird für die Zertifikatsprüfung gebraucht, nicht nur 443)
#   - nickberdi.ch zeigt auf die öffentliche IP des Anschlusses (siehe DDNS im README)

nickberdi.ch, www.nickberdi.ch {
	encode zstd gzip

	# Caddy setzt X-Forwarded-Proto automatisch — davon hängt ab, dass das
	# Sitzungs-Cookie des Admin-Bereichs das Secure-Flag bekommt.
	reverse_proxy 127.0.0.1:4000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/nickberdi.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# Optional, zusätzlicher Riegel: Admin-Bereich nur aus dem Heimnetz erreichbar.
# Dann kann sich von aussen niemand am Anmeldeformular versuchen.
# Zum Aktivieren die folgenden Zeilen in den Block oben verschieben:
#
#	@admin path /admin.html /api/*
#	handle @admin {
#		@fremd not client_ip 192.168.1.0/24
#		respond @fremd 404
#		reverse_proxy 127.0.0.1:4000
#	}
