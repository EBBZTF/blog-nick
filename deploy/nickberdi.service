# systemd unit for the website server.
#
#   sudo cp deploy/nickberdi.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nickberdi
#   systemctl status nickberdi
#
# Adjust the paths and user below if the project lives somewhere else.

[Unit]
Description=berdi-racing.com — website and admin area
Documentation=file:///home/pi/nick-blog/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/nick-blog
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

# Caddy takes 80/443 and forwards here — which is why the Node server stays on
# localhost and is deliberately not reachable directly from outside.
Environment=HOST=127.0.0.1
Environment=PORT=4000
Environment=NODE_ENV=production

# Credentials for the notification mail. Deliberately a separate file: this
# unit is in the repository and the key must never end up there.
#
#   sudo install -m 600 /dev/null /etc/nickberdi.env
#   sudo tee /etc/nickberdi.env >/dev/null <<'ENV'
#   RESEND_API_KEY=re_...
#   MAIL_TO=nick@berdi-racing.com
#   MAIL_FROM=website@berdi-racing.com
#   ENV
#
# If the file or any of the variables is missing, no mail is sent at all — the
# enquiry still lands in data/inquiries.json.
EnvironmentFile=-/etc/nickberdi.env

# Hardening: the process may not change anything on disk except data/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/pi/nick-blog/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
