# Sichert den Inhalt täglich.
#
#   sudo cp deploy/nickberdi-backup.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nickberdi-backup.timer
#   systemctl list-timers nickberdi-backup

[Unit]
Description=Tägliche Sicherung des Website-Inhalts

[Timer]
OnCalendar=daily
# Nachholen, falls die Pi zum geplanten Zeitpunkt aus war.
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
