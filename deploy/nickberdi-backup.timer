# Backs up the content daily.
#
#   sudo cp deploy/nickberdi-backup.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nickberdi-backup.timer
#   systemctl list-timers nickberdi-backup

[Unit]
Description=Daily backup of the website content

[Timer]
OnCalendar=daily
# Catch up if the Pi was off at the scheduled time.
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
